{
  // Launch configurations працюють у devcontainer і використовують GDB з image.
  // Для ДЗ 5 потрібно буде додати окрему конфігурацію за цим прикладом.
  "version": "0.2.0",
  "configurations": [
    {
      // Локальний debug demo-коду заняття 2.4. Використовує bad input,
      // щоб GDB зупинився на runtime crash.
      "name": "Debug demo 2.4: debug_probe",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/demos/lesson_2_4/debug_probe/debug_probe",
      "args": [
        "${workspaceFolder}/demos/lesson_2_4/debug_probe/data/bad_missing_field.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: configure and build",
      "setupCommands": [
        {
          "description": "Увімкнути pretty-printing для STL типів у GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      // Локальний debug стартера ДЗ 4. preLaunchTask збирає debug preset.
      "name": "Debug homework_04: ugv_odometry",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/homework_04/ugv_odometry",
      "args": [
        "${workspaceFolder}/homework_04/data/straight.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: configure and build",
      "setupCommands": [
        {
          "description": "Увімкнути pretty-printing для STL типів у GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "ROS2 hw14: underground_world_node (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework_14/robot_ws/install/underground_world/lib/underground_world/underground_world_node",
      "preLaunchTask": "ROS2: colcon build (hw14)",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/homework_14/robot_ws",
      "environment": [
        { "name": "AMENT_PREFIX_PATH", "value": "${workspaceFolder}/homework_14/robot_ws/install/underground_world:/opt/ros/jazzy" },
        { "name": "LD_LIBRARY_PATH", "value": "${workspaceFolder}/homework_14/robot_ws/install/underground_world/lib:/opt/ros/jazzy/lib:/opt/ros/jazzy/lib/x86_64-linux-gnu" },
        { "name": "RMW_IMPLEMENTATION", "value": "rmw_cyclonedds_cpp" },
        { "name": "ROS_DOMAIN_ID", "value": "0" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
